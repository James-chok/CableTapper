require "open3"
require "shellwords"

default_platform(:mac)

TEAM_ID = "FL2S59F6Z6"
KEYCHAIN_NAME = "fastlane_tmp_keychain"

platform :mac do
  desc "Build a notarized Developer ID app and leave a zip in dist/"
  lane :release do
    tag = ENV.fetch("GITHUB_REF_NAME")
    UI.user_error!("This lane runs from a v* tag") unless tag.start_with?("v")
    version = tag.delete_prefix("v")
    build_number = ENV.fetch("GITHUB_RUN_NUMBER")

    setup_ci(keychain_name: KEYCHAIN_NAME)
    import_signing
    api_key = asc_api_key

    # App Store export and upload.
    # Restoring this also needs the Apple Distribution certificate, the Mac
    # Installer Distribution certificate, and the Mac App Store profile.
    # Sign that archive with "Apple Distribution" and the CableTapper profile,
    # and point the app target at Resources/CableTapperAppStore.entitlements.
    # profile_name = provisioning_profile_name(ENV.fetch("MAC_APPSTORE_PROFILE_PATH"))
    # install_provisioning_profile(path: ENV.fetch("MAC_APPSTORE_PROFILE_PATH"))
    # pkg_path = build_app(
    #   project: "CableTapper.xcodeproj",
    #   scheme: "CableTapper",
    #   configuration: "Release",
    #   destination: "generic/platform=macOS",
    #   export_method: "app-store",
    #   export_team_id: TEAM_ID,
    #   export_options: {
    #     signingStyle: "manual",
    #     signingCertificate: "Apple Distribution",
    #     installerSigningCertificate: "Mac Installer Distribution",
    #     provisioningProfiles: {
    #       "io.github.james-chok.cabletapper" => profile_name
    #     }
    #   },
    #   xcconfig: xcconfig.path,
    #   output_directory: "dist/appstore",
    #   output_name: "CableTapper"
    # )
    # upload_to_app_store(
    #   pkg: pkg_path,
    #   platform: "osx",
    #   skip_metadata: true,
    #   skip_screenshots: true,
    #   skip_app_version_update: true,
    #   force: true,
    #   run_precheck_before_submit: false,
    #   precheck_include_in_app_purchases: false
    # )

    xcconfig = release_xcconfig(version, build_number)
    app_path = build_app(
      project: "CableTapper.xcodeproj",
      scheme: "CableTapper",
      configuration: "Release",
      destination: "generic/platform=macOS",
      export_method: "developer-id",
      export_team_id: TEAM_ID,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Developer ID Application",
        teamID: TEAM_ID
      },
      skip_profile_detection: true,
      xcconfig: xcconfig.path,
      output_directory: "dist",
      output_name: "CableTapper"
    )
    notarize(package: app_path, api_key: api_key, print_log: true)
    FileUtils.rm_f("#{app_path}.zip")
    sh("spctl", "--assess", "--type", "execute", "--verbose=2", app_path)
    # fastlane runs inside fastlane/, so a relative dist/ would miss the repo-root directory the release step uploads.
    dist_dir = File.expand_path("../dist", __dir__)
    zip_path = File.join(dist_dir, "CableTapper-#{tag}.zip")
    sha_path = File.join(dist_dir, "CableTapper-#{tag}.sha256")
    sh("ditto", "-c", "-k", "--keepParent", app_path, zip_path)
    sh("bash", "-c", "cd #{dist_dir.shellescape} && shasum -a 256 #{File.basename(zip_path).shellescape} > #{File.basename(sha_path).shellescape}")
  end
end

def import_signing
  import_certificate(
    certificate_path: ENV.fetch("DEVELOPER_ID_P12_PATH"),
    certificate_password: ENV.fetch("DEVELOPER_ID_P12_PASSWORD"),
    keychain_name: KEYCHAIN_NAME,
    keychain_password: ""
  )
  # App Store signing, used by the export commented out above.
  # {
  #   "APPLE_DISTRIBUTION_P12_PATH" => "APPLE_DISTRIBUTION_P12_PASSWORD",
  #   "MAC_INSTALLER_DISTRIBUTION_P12_PATH" => "MAC_INSTALLER_DISTRIBUTION_P12_PASSWORD"
  # }.each do |path_key, password_key|
  #   import_certificate(
  #     certificate_path: ENV.fetch(path_key),
  #     certificate_password: ENV.fetch(password_key),
  #     keychain_name: KEYCHAIN_NAME,
  #     keychain_password: ""
  #   )
  # end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8_BASE64"),
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

def provisioning_profile_name(profile_path)
  stdout, status = Open3.capture2("security", "cms", "-D", "-i", profile_path)
  UI.user_error!("Could not read the provisioning profile") unless status.success?
  plist_path = File.join(Dir.tmpdir, "appstore-profile.plist")
  File.write(plist_path, stdout)
  name, name_status = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :Name", plist_path)
  UI.user_error!("Could not read the provisioning profile name") unless name_status.success?
  name.strip
end

def release_xcconfig(version, build_number)
  # gym passes this file to every target, including Swift packages. The signing
  # identity stays on the app target so packages are not resigned.
  file = Tempfile.new(["release", ".xcconfig"])
  file.write(<<~XCCONFIG)
    DEVELOPMENT_TEAM = #{TEAM_ID}
    MARKETING_VERSION = #{version}
    CURRENT_PROJECT_VERSION = #{build_number}
  XCCONFIG
  file.close
  file
end
